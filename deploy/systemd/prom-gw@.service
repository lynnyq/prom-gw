[Unit]
Description=Prometheus RemoteWrite Gateway (city=%i)
Documentation=https://github.com/lynnyq/bigdata
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=bdops
Group=bdops
# 通过 systemd template 实例化,按城市加载独立配置
#   - prom-gw@bj.service -> /appdata/prom-gw/conf/rules.yaml (源: configs/rules/bj/default.yaml)
#   - prom-gw@sz.service -> /appdata/prom-gw/conf/rules.yaml (源: configs/rules/sz/default.yaml)
#   - prom-gw@hf.service -> /appdata/prom-gw/conf/rules.yaml (源: configs/rules/hf/default.yaml)
Environment=INGEST_CITY=%i
Environment=PROM_GW_CONFIG=/appdata/prom-gw/conf/rules.yaml
Environment=PROM_GW_TOKENS=/appdata/prom-gw/conf/tokens.yaml
ExecStart=/appdata/prom-gw/bin/prom-gw \
  --config=/appdata/prom-gw/conf/rules.yaml \
  --tokens=/appdata/prom-gw/conf/tokens.yaml \
  --ingest-city=%i
Restart=always
RestartSec=5
StartLimitIntervalSec=60
StartLimitBurst=10

# 资源限制
LimitNOFILE=65535
LimitNPROC=65535
LimitCORE=infinity
MemoryMax=8G
TasksMax=8192

# 优雅停机
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=30
FinalKillSignal=SIGKILL

# 环境
Environment=GOMAXPROCS=8
Environment=GOMEMLIMIT=6GiB
EnvironmentFile=-/etc/prom-gw/prom-gw.env

# 安全加固
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/data/wal /var/log/prom-gw
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
RestrictNamespaces=true

# 日志走 journald,JSON 由 prom-gw 自行输出
StandardOutput=journal
StandardError=journal
SyslogIdentifier=prom-gw

[Install]
WantedBy=multi-user.target
