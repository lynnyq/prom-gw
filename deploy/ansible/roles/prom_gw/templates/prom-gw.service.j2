[Unit]
Description=prom-gw ({{ item }}) — template service for city-scoped deployments
Documentation=https://github.com/lynnyq/bigdata
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ prom_gw_user }}
Group={{ prom_gw_group }}
# spec 9.1: 通过 systemd template 实例化,按城市分目录加载规则(spec 9.3)
Environment=INGEST_CITY={{ item }}
Environment=PROM_GW_CONFIG={{ prom_gw_config_dir }}/{{ item }}/rules.yaml
Environment=PROM_GW_TOKENS={{ prom_gw_config_dir }}/tokens.yaml
EnvironmentFile={{ prom_gw_config_dir }}/prom-gw.env
ExecStart={{ prom_gw_release_dir }}/prom-gw \
    --config={{ prom_gw_config_dir }}/{{ item }}/rules.yaml \
    --tokens={{ prom_gw_config_dir }}/tokens.yaml \
    --ingest-city={{ item }} \
    --source-dc={{ item }} \
    --metrics-addr=:{{ prom_gw_metrics_port }} \
    --health-addr=:{{ prom_gw_health_port }} \
    --write-addr=:{{ prom_gw_base_port }} \
    --admin-addr=:{{ prom_gw_admin_port }} \
    --admin-allow-cidr={{ prom_gw_admin_allow_cidr }} \
    --wal-dir={{ prom_gw_wal_dir }}/{{ item }}
Restart=always
RestartSec=5s
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
