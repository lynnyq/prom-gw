{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "title": "总吞吐 (samples/s)",
      "type": "timeseries",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "palette-classic"}}},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["last", "mean", "max"]}, "tooltip": {"mode": "multi"}},
      "targets": [
        {
          "expr": "sum(rate(gateway_samples_total{stage=\"parse\",status=\"ok\"}[1m]))",
          "legendFormat": "parse ok",
          "refId": "A"
        },
        {
          "expr": "sum(rate(gateway_samples_total{stage=\"rule\",status=\"drop\"}[1m]))",
          "legendFormat": "rule drop",
          "refId": "B"
        }
      ]
    },
    {
      "title": "HTTP 入口请求 (req/s)",
      "type": "timeseries",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "fieldConfig": {"defaults": {"unit": "reqps"}},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["last", "mean", "max"]}, "tooltip": {"mode": "multi"}},
      "targets": [
        {
          "expr": "sum(rate(gateway_request_duration_seconds_count[1m]))",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ]
    },
    {
      "title": "端到端延迟 (p50/p95/p99)",
      "type": "timeseries",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "fieldConfig": {"defaults": {"unit": "s"}},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["last", "mean", "max"]}, "tooltip": {"mode": "multi"}},
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(gateway_request_duration_seconds_bucket{endpoint=\"/api/v1/write\",status=\"ok\"}[1m])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(gateway_request_duration_seconds_bucket{endpoint=\"/api/v1/write\",status=\"ok\"}[1m])))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(gateway_request_duration_seconds_bucket{endpoint=\"/api/v1/write\",status=\"ok\"}[1m])))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ]
    },
    {
      "title": "错误率 (errors/s)",
      "type": "timeseries",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "fieldConfig": {"defaults": {"unit": "short"}},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["last", "mean", "max"]}, "tooltip": {"mode": "multi"}},
      "targets": [
        {
          "expr": "sum by (stage) (rate(gateway_errors_total[1m]))",
          "legendFormat": "{{stage}}",
          "refId": "A"
        }
      ]
    },
    {
      "title": "背压拒绝率 (503)",
      "type": "timeseries",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
      "fieldConfig": {"defaults": {"unit": "short"}},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["last", "max"]}, "tooltip": {"mode": "multi"}},
      "targets": [
        {
          "expr": "sum(rate(gateway_backpressure_rejected_total[1m]))",
          "legendFormat": "{{stage}}",
          "refId": "A"
        }
      ]
    },
    {
      "title": "WAL 容量",
      "type": "timeseries",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
      "fieldConfig": {"defaults": {"unit": "bytes"}},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["last", "max"]}, "tooltip": {"mode": "multi"}},
      "targets": [
        {
          "expr": "gateway_wal_bytes",
          "legendFormat": "WAL bytes",
          "refId": "A"
        },
        {
          "expr": "gateway_wal_oldest_age_seconds",
          "legendFormat": "oldest age (s)",
          "refId": "B"
        },
        {
          "expr": "rate(gateway_wal_hard_reject_total[1m])",
          "legendFormat": "hard reject rate",
          "refId": "C"
        }
      ]
    },
    {
      "title": "规则引擎状态",
      "type": "stat",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 24},
      "fieldConfig": {"defaults": {"unit": "none"}},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"},
      "targets": [
        {
          "expr": "gateway_ruleset_version",
          "legendFormat": "{{name}}",
          "refId": "A"
        }
      ]
    },
    {
      "title": "规则热切换次数 (1h)",
      "type": "timeseries",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": {"h": 8, "w": 12, "x": 6, "y": 24},
      "fieldConfig": {"defaults": {"unit": "short"}},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["last", "max"]}, "tooltip": {"mode": "multi"}},
      "targets": [
        {
          "expr": "sum by (name, from_version, to_version) (increase(gateway_ruleset_switch_total[1h]))",
          "legendFormat": "{{name}} {{from_version}}->{{to_version}}",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Goroutines / 内存",
      "type": "timeseries",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 32},
      "fieldConfig": {"defaults": {"unit": "short"}},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["last", "max"]}, "tooltip": {"mode": "multi"}},
      "targets": [
        {
          "expr": "gateway_goroutines",
          "legendFormat": "goroutines",
          "refId": "A"
        },
        {
          "expr": "go_memstats_heap_inuse_bytes",
          "legendFormat": "heap inuse",
          "refId": "B"
        }
      ]
    },
    {
      "title": "字节流量 (in / out)",
      "type": "timeseries",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 32},
      "fieldConfig": {"defaults": {"unit": "Bps"}},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["last", "max"]}, "tooltip": {"mode": "multi"}},
      "targets": [
        {
          "expr": "sum by (business) (rate(gateway_bytes_in_total[1m]))",
          "legendFormat": "in {{business}}",
          "refId": "A"
        },
        {
          "expr": "sum by (topic) (rate(gateway_bytes_out_total[1m]))",
          "legendFormat": "out {{topic}}",
          "refId": "B"
        }
      ]
    },
    {
      "title": "鉴权失败 (按 reason)",
      "type": "timeseries",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 40},
      "fieldConfig": {"defaults": {"unit": "short"}},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["last", "max"]}, "tooltip": {"mode": "multi"}},
      "targets": [
        {
          "expr": "sum by (reason) (rate(gateway_auth_fail_total[1m]))",
          "legendFormat": "{{reason}}",
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["prom-gw", "remote-write"],
  "templating": {
    "list": [
      {
        "current": {"selected": false, "text": "Prometheus", "value": "Prometheus"},
        "hide": 0,
        "includeAll": false,
        "label": "Datasource",
        "multi": false,
        "name": "DS_PROMETHEUS",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "type": "datasource"
      }
    ]
  },
  "time": {"from": "now-1h", "to": "now"},
  "timepicker": {},
  "timezone": "",
  "title": "prom-gw Overview",
  "uid": "prom-gw-overview",
  "version": 1,
  "weekStart": ""
}
